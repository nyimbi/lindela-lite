# Lindela Lite one-click deployment settings

LINDELA_LITE_PORT=4177
LINDELA_LITE_API_KEY=change-me

# Docker Compose PostgreSQL settings
POSTGRES_DB=lindela_lite
POSTGRES_USER=lindela
POSTGRES_PASSWORD=change-me
LINDELA_LITE_DB_MODE=postgres
LINDELA_LITE_DATABASE_URL=postgresql://lindela:change-me@db:5432/lindela_lite

# Scheduler sidecar interval for ingestion/report run-due calls.
LINDELA_LITE_SCHEDULER_INTERVAL_SECONDS=900

# Optional public source settings
NASA_FIRMS_MAP_KEY=OPEN_KEY

# Optional RapidPro settings
RAPIDPRO_BASE_URL=https://rapidpro.io
RAPIDPRO_API_TOKEN=
RAPIDPRO_ALERT_MODE=flow_start
RAPIDPRO_ALERT_FLOW_UUID=
RAPIDPRO_ALERT_URNS=
RAPIDPRO_ALERT_CONTACTS=
RAPIDPRO_ALERT_GROUPS=
RAPIDPRO_BASE_LANGUAGE=eng
RAPIDPRO_WEBHOOK_SECRET=
