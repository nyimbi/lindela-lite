  {
    "id": "noaa_enso",
    "module": "src/connectors/noaa-enso.js",
    "description": "NOAA CPC Nino 3.4 SST anomaly index (ONI), fixed-width ASCII. Advisory strength only: CPC declares an ENSO episode only after five consecutive overlapping three-month seasons.",
    "schemas": {
      "input": {
        "enso_window_months": "number - how many recent months to store (default 18)",
        "enso_threshold_c": "number - advisory threshold in degC (default 0.5, CPC published value)",
        "enso_feed": "string - override feed URL",
        "timeout_ms": "number",
        "retries": "number"
      },
      "output": [
        "climate_observations"
      ]
    },
    "defaults": {
      "rateLimit": {
        "perMinute": 30
      },
      "retry": {
        "max": 2,
        "backoffMs": 1000
      },
      "timeout_ms": 20000
    },
    "tags": [
      "climate",
      "enso",
      "seasonal",
      "index"
    ],
    "contributor": "core",
    "source": "NOAA Climate Prediction Center",
    "license": "U.S. Government work, public domain",
    "since": "0.3.0"
  },
