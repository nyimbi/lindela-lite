  {
    "id": "dhis2",
    "module": "src/connectors/dhis2.js",
    "description": "DHIS2 bidirectional sync scaffold (configure base_url and api_token to activate)",
    "schemas": {
      "input": {
        "base_url": "string \u2014 DHIS2 instance root URL",
        "api_token": "string \u2014 personal access token",
        "org_units": "array of string \u2014 org unit UIDs",
        "data_elements": "array of string \u2014 data element UIDs",
        "period": "string \u2014 DHIS2 period e.g. 2026Q3"
      },
      "output": [
        "climate_observations"
      ]
    },
    "defaults": {
      "timeout_ms": 20000,
      "retries": 1
    },
    "tags": [
      "dhis2",
      "health",
      "bidirectional",
      "scaffold"
    ],
    "contributor": "core",
    "since": "0.2.0"
