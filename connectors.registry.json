[
  {
    "id": "open_meteo",
    "module": "src/connectors/open-meteo.js",
    "description": "Open-Meteo weather forecasts and observations",
    "schemas": {
      "input": {
        "regions": "array of {name, country, lat, lon}",
        "forecast_days": "number",
        "include_ensemble": "boolean",
        "timeout_ms": "number",
        "retries": "number"
      },
      "output": ["climate_observations"]
    },
    "defaults": {
      "rateLimit": {"perMinute": 60},
      "retry": {"max": 2, "backoffMs": 1000},
      "timeout_ms": 20000
    },
    "tags": ["climate", "forecast", "weather"],
    "contributor": "core",
    "since": "0.1.0"
  },
