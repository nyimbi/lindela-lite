diff --git a/src/postgres-store.js b/src/postgres-store.js
index 3f5e9e5..8958448 100644
--- a/src/postgres-store.js
+++ b/src/postgres-store.js
@@ -161,8 +161,56 @@ export class PostgresStore {
     )
   }
 
-  async replaceAnalytics({ risk_scores = [], impact_assessments = [], data_quality = [], road_access = [] }) {
-    return this.merge({ risk_scores, impact_assessments, data_quality, road_access })
+  /**
+   * Replace the derived analytics collections wholesale.
+   *
+   * This delegated to `merge()`, which is the opposite operation in two ways.
+   *
+   * It MERGED rather than replaced, so a region that stops qualifying — no
+   * longer in scope, no inputs — kept its last computed risk score forever.
+   * The JSON store replaced, so the two backends disagreed about whether stale
+   * analytics persist.
+   *
+   * It also took four parameters against JsonStore's six, so
+   * `population_at_risk` and `facilities_at_risk` were computed by
+   * `refreshAnalytics`, passed in, and silently discarded. On the Postgres
+   * backend the impact-based figures — the people-at-risk and
+   * facilities-at-risk that roadmap item 3 exists to produce — were never
+   * written at all.
+   *
+   * Delete-then-insert per collection, in one transaction.
+   */
+  async replaceAnalytics({
+    risk_scores = [],
+    impact_assessments = [],
+    data_quality = [],
+    population_at_risk = [],
+    facilities_at_risk = [],
+    road_access = [],
+  }) {
+    const client = await this.connect()
+    const collections = {
+      risk_scores,
+      impact_assessments,
+      data_quality,
+      population_at_risk,
+      facilities_at_risk,
+      road_access,
+    }
+
+    await client.query('BEGIN')
+    try {
+      for (const [collection, items] of Object.entries(collections)) {
+        await client.query('DELETE FROM lite_records WHERE collection = $1', [collection])
+        if (items.length) await this.upsertCollection(client, collection, items)
+      }
+      await client.query('COMMIT')
+    } catch (error) {
+      await client.query('ROLLBACK')
+      throw error
+    }
+
+    return this.read()
   }
 
   async close() {
