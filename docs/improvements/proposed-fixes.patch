+/**
+ * The collections a connector may return.
+ *
+ * Kept as one list because `countRecords`, `countRecordsByCollection` and the
+ * `merged` accumulator below all have to agree. They did not: the counts read
+ * four keys while ingestion merged six, so `ipc_hdx` and `who_gho` always
+ * counted zero, never cleared `minimum_records`, and reported `degraded` with
+ * "Expected at least 1 records; received 0" however many IPC classifications or
+ * outbreak observations they had actually fetched.
+ */
+const OUTPUT_COLLECTIONS = [
+  'climate_observations',
+  'hazard_events',
